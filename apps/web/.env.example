# Copy to .env.local (never commit it).
# API: http://localhost:4010 = Prism mock, http://localhost:8000 = the real backend.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Sign-in (Supabase + Google). Leave both empty for development mode (the API gets a "dev" token).
# The anon key is public by design; the service-role key must never go in this app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
