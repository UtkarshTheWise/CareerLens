{
  "name": "extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && vite build --config vite.extractor.config.ts",
    "test": "node --experimental-transform-types --import ./tests/register.mjs --test src/adapters/__tests__/*.test.ts src/__tests__/*.test.ts"
  },
  "dependencies": {
    "@careerlens/api-client": "workspace:*",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@supabase/supabase-js": "^2.117.3",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/chrome": "0.3.4",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "vite": "8.3.3"
  }
}
