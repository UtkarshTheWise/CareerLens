# Copy to .env.local (never commit it). Values are baked into the build.
# API the extension talks to by default (the Options page can still change it).
VITE_API_URL=http://localhost:8000
# Sign-in (Supabase + Google). Leave empty for a development build with no sign-in.
# The anon key is public by design; the service-role key must never go in the extension.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
