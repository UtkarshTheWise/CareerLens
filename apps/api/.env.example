# Copy to apps/api/.env and fill in. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-3.5-flash-lite   # confirm exact IDs in AI Studio
GEMINI_MODEL_SMART=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OLLAMA_URL=http://localhost:11434          # optional
OLLAMA_MODEL=llama3.2                     # a local model you have pulled; used only if OLLAMA_URL is set
GITHUB_TOKEN=
DATABASE_URL=sqlite:///./dev.db            # or the Supabase string: postgresql+psycopg://...
SUPABASE_JWT_SECRET=                       # HS256 projects: Project Settings > API > JWT secret
SUPABASE_URL=                              # asymmetric-key projects: https://<ref>.supabase.co (tokens checked via JWKS)
PLACEMENT_STAFF=                           # comma-separated emails or user ids who may see cohort data
ENVIRONMENT=development                    # production refuses DEV_AUTH=1 and needs a token key above
DEV_AUTH=1                                 # local only: accept every request as the demo user
CORS_ORIGINS=http://localhost:3000        # extension origins are allowed by regex in code
